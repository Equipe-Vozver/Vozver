# Modelo das variáveis do banco. Copie para ".env" e coloque os dados do SEU banco.
# O .env nunca vai para o GitHub (está no .gitignore).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_SENHA=
DB_NOME=vozver
# Só para o banco online (Aiven): nome do certificado que fica em backend/. No XAMPP, deixe vazio.
DB_SSL_CA=